        }
      }
    },
    "ほかに %d 件の献立があります。Pro ですべて見られます。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d older menus saved. Pro shows them all."
